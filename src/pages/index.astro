---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';
import LatestGuides from '../components/LatestGuides.astro';
import LiveScores from '../components/LiveScores.astro';
import { getCurrentYear } from '../utils/year';

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "IPTV CZ Předplatné",
  "description": "Nejlepší internetová televize IPTV v ČR. Stabilní 4K obraz a exkluzivní bonusy.",
  "brand": {
    "@type": "Brand",
    "name": "IPTV-CZ"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "5.00",
    "highPrice": "35.00",
    "priceCurrency": "EUR",
    "offerCount": "4"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "5234"
  }
};
---
<Layout title={`IPTV CZ - Nejlepší Internetová Televize ${getCurrentYear()} | IPTV-CZ`} description="Sledujte prémiovou IPTV CZ bez sekání. 4K kvalita, stabilní servery. Získejte předplatné od 5 EUR měsíčně. Podpora Smart TV, Android, iOS." schema={schema}>
  <StickyHeader />
  
  <main>
    <div class="relative">
      <Hero />
    </div>
    
    <LiveScores />
    
    <FeatureGrid />
    
    <section id="pricing" class="py-24 bg-gray-900/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Vyberte si své předplatné</h2>
          <p class="text-gray-400">Bez závazků, s okamžitým doručením a 24/7 podporou.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 items-center lg:items-stretch pt-4">
          <PricingCard 
            title="12 Měsíců" 
            price="35 €" 
            period="rok" 
            isPopular={true}
            bonus="IBO Player Aktivace ZDARMA"
            features={["4K / FHD Kvalita", "Archív & Zpětné zhlédnutí", "Premium Sport a Filmy", "24/7 VIP Podpora", "Anti-Freeze Technologie"]} 
          />
          <PricingCard 
            title="6 Měsíců" 
            price="20 €" 
            period="půlrok" 
            features={["4K / FHD Kvalita", "Archív & Zpětné zhlédnutí", "Premium Sport a Filmy", "24/7 Podpora"]} 
          />
          <PricingCard 
            title="3 Měsíce" 
            price="10 €" 
            period="čtvrtletí" 
            features={["4K / FHD Kvalita", "Archív", "Základní Podpora"]} 
          />
          <PricingCard 
            title="1 Měsíc" 
            price="5 €" 
            period="měsíc" 
            features={["4K / FHD Kvalita", "Základní Podpora"]} 
          />
        </div>
      </div>
    </section>
    
    <ReferralBanner />
    <UserReviewsSection />
    <ProcessSteps />
    <SupportedDevices />
    <CitiesList />
    <LatestGuides />
    <ContactForm />
    <FAQSection />
    <CTASection />
  </main>

  <FloatingWhatsApp />
  <GroupsPopup />
  <ExitPopup />
  <SocialPopup />
</Layout>
