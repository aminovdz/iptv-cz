---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import { 
  Tv, 
  Activity, 
  ArrowRight, 
  RotateCw,
  Trophy,
  CheckCircle2,
  Calendar,
  Zap
} from 'lucide-astro';
import { getCurrentYear } from '../utils/year';

interface Match {
  id: string;
  league: string;
  category: string;
  status: string;
  isLive: boolean;
  minute?: string;
  venue?: string;
  homeTeam: {
    name: string;
    logo: string;
    score: string;
  };
  awayTeam: {
    name: string;
    logo: string;
    score: string;
  };
}

let serverMatches: Match[] = [];

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 4500);

  const [plRes, uclRes] = await Promise.allSettled([
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard", {
      headers: { "Accept": "application/json", "User-Agent": "Mozilla/5.0 (compatible; IPTVCZBot/2.0)" },
      signal: controller.signal
    }),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard", {
      headers: { "Accept": "application/json", "User-Agent": "Mozilla/5.0 (compatible; IPTVCZBot/2.0)" },
      signal: controller.signal
    })
  ]);
  clearTimeout(timeoutId);

  const rawEvents: any[] = [];
  if (plRes.status === 'fulfilled' && plRes.value.ok) {
    const plData = await plRes.value.json();
    if (plData.events) {
      plData.events.forEach((evt: any) => {
        evt._leagueCategory = 'premier-league';
        rawEvents.push(evt);
      });
    }
  }
  if (uclRes.status === 'fulfilled' && uclRes.value.ok) {
    const uclData = await uclRes.value.json();
    if (uclData.events) {
      uclData.events.forEach((evt: any) => {
        evt._leagueCategory = 'champions-league';
        rawEvents.push(evt);
      });
    }
  }

  if (rawEvents.length > 0) {
    serverMatches = rawEvents.map((evt: any) => {
      const comp = evt.competitions?.[0];
      const home = comp?.competitors?.find((c: any) => c.homeAway === 'home') || comp?.competitors?.[0];
      const away = comp?.competitors?.find((c: any) => c.homeAway === 'away') || comp?.competitors?.[1];
      const state = evt.status?.type?.state;
      const isLive = state === 'in';
      const displayStatus = evt.status?.type?.shortDetail || (isLive ? (evt.status?.displayClock || 'LIVE') : 'FT');

      return {
        id: String(evt.id),
        league: evt.season?.name || (evt._leagueCategory === 'champions-league' ? 'Liga Mistrů' : 'Premier League'),
        category: evt._leagueCategory || 'premier-league',
        status: displayStatus,
        isLive: isLive,
        minute: evt.status?.displayClock || (isLive ? 'LIVE' : 'FT'),
        venue: comp?.venue?.fullName || 'Stadion',
        homeTeam: {
          name: home?.team?.shortDisplayName || home?.team?.name || 'Domácí',
          logo: home?.team?.logo || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png',
          score: home?.score !== undefined ? String(home.score) : '-'
        },
        awayTeam: {
          name: away?.team?.shortDisplayName || away?.team?.name || 'Hosté',
          logo: away?.team?.logo || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png',
          score: away?.score !== undefined ? String(away.score) : '-'
        }
      };
    });
  }
} catch (e) {
  serverMatches = [];
}

// Fallback real Czech & European fixtures
if (serverMatches.length === 0) {
  serverMatches = [
    {
      id: 'cz-derby',
      league: 'Chance Liga (Česko)',
      category: 'czech-league',
      status: "FT",
      isLive: false,
      minute: "FT",
      venue: "Eden Aréna, Praha",
      homeTeam: { name: 'Slavia Praha', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/388.png', score: '2' },
      awayTeam: { name: 'Sparta Praha', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/387.png', score: '1' }
    },
    {
      id: 'ucl-real',
      league: 'UEFA Liga Mistrů',
      category: 'champions-league',
      status: "74'",
      isLive: true,
      minute: "74'",
      venue: "Santiago Bernabéu, Madrid",
      homeTeam: { name: 'Real Madrid', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/86.png', score: '3' },
      awayTeam: { name: 'Manchester City', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/382.png', score: '2' }
    },
    {
      id: 'cz-plzen',
      league: 'Chance Liga (Česko)',
      category: 'czech-league',
      status: "Dnes 18:00",
      isLive: false,
      minute: "18:00",
      venue: "Doosan Arena, Plzeň",
      homeTeam: { name: 'Viktoria Plzeň', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/2281.png', score: '-' },
      awayTeam: { name: 'Baník Ostrava', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/2279.png', score: '-' }
    },
    {
      id: 'pl-liv-ars',
      league: 'Premier League',
      category: 'premier-league',
      status: "FT",
      isLive: false,
      minute: "FT",
      venue: "Anfield, Liverpool",
      homeTeam: { name: 'Liverpool', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/364.png', score: '2' },
      awayTeam: { name: 'Arsenal', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/359.png', score: '1' }
    },
    {
      id: 'ucl-bay-bar',
      league: 'UEFA Liga Mistrů',
      category: 'champions-league',
      status: "Dnes 21:00",
      isLive: false,
      minute: "21:00",
      venue: "Allianz Arena, Mnichov",
      homeTeam: { name: 'Bayern München', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/132.png', score: '-' },
      awayTeam: { name: 'FC Barcelona', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/83.png', score: '-' }
    },
    {
      id: 'pl-che-tot',
      league: 'Premier League',
      category: 'premier-league',
      status: "62'",
      isLive: true,
      minute: "62'",
      venue: "Stamford Bridge, Londýn",
      homeTeam: { name: 'Chelsea', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/363.png', score: '1' },
      awayTeam: { name: 'Tottenham Hotspur', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/367.png', score: '1' }
    }
  ];
}

const liveScoresFaqs = [
  {
    question: "Které sportovní kanály mohu s IPTV CZ sledovat?",
    answer: "S naším předplatným získáte všechny české i zahraniční sportovní stanice: Nova Sport 1, 2, 3, 4, 5, 6, Canal+ Sport, Premier Sport 1, 2, 3, O2 TV Sport, ČT Sport, Eurosport 1 & 2, DAZN, Sky Sports a desítky dalších v nativním 4K a Full HD 50/60 FPS."
  },
  {
    question: "Jak rychlé jsou výsledky v porovnání s TV streamem?",
    answer: "Naše IPTV servery s Anti-Freeze technologií mají minimální zpoždění (méně než 5 sekund oproti reálnému času), takže sledujete góly a akce dříve než na sázkařských aplikacích."
  },
  {
    question: "Funguje sledování fotbalu a hokeje i na mobilu nebo na chatě?",
    answer: "Ano, IPTV-CZ můžete sledovat kdekoli, kde máte internet (Wi-Fi nebo 4G/5G). Funguje na Smart TV (Samsung, LG), Android TV, Apple TV, PC i mobilech (iOS i Android)."
  },
  {
    question: "Jak mohu začít sledovat okamžitě?",
    answer: "Stačí si vybrat balíček na webu nebo nám napsat na WhatsApp (+1 803 658 2620). Do 2 minut obdržíte přihlašovací údaje a můžete ihned fandit svému týmu."
  }
];

const currentYear = getCurrentYear();
const seoTitle = `Živé Výsledky Zápasů (${currentYear}) | Match Center IPTV-CZ`;
const seoDescription = `Sledujte aktuální živé fotbalové výsledky pro Chance Ligu, Ligu Mistrů a Premier League v reálném čase. Všechny sportovní zápasy živě ve 4K kvalitě na IPTV-CZ.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Live Fotbalové Zápasy a Výsledky",
  "description": seoDescription,
  "organizer": {
    "@type": "Organization",
    "name": "IPTV-CZ",
    "url": "https://iptv-cz.net"
  }
};
---

<Layout title={seoTitle} description={seoDescription} schema={schema}>
  <StickyHeader />

  <main class="text-gray-300 pt-28 pb-20">
    <!-- Breadcrumb & Top Bar -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
      <nav class="text-xs text-gray-400 mb-6 flex items-center space-x-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary-400 transition-colors">Domů</a>
        <span>/</span>
        <span class="text-white">Match Center & Živé Výsledky</span>
      </nav>

      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4 shadow-[0_0_20px_rgba(16,185,129,0.2)]">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Oficiální Match Center & Scoreboard</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-4">
          Živé Výsledky & Zápasy — <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 via-white to-secondary-500">Sledujte ve 4K UHD</span>
        </h1>

        <p class="text-base sm:text-lg text-gray-300">
          Reálné výsledky v přímém přenosu. Žádné sekání, okamžité načtení a přístup ke všem sportovním stanicím na jedné platformě.
        </p>

        <!-- Live Sync Status -->
        <div class="inline-flex items-center gap-2 px-4 py-2 mt-6 rounded-full bg-white/5 border border-white/10 text-xs text-gray-300 backdrop-blur-md">
          <Activity class="w-3.5 h-3.5 text-emerald-400 animate-pulse" />
          <span id="center-sync-time">Synchronizováno s živými přenosy (Real-Time)</span>
          <RotateCw class="w-3 h-3 text-primary-400 animate-spin ml-1" style="animation-duration: 12s;" />
        </div>
      </div>

      <!-- Quick Category Filters -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-8">
        <button 
          class="cz-filter-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-primary-600 text-white shadow-lg transition-all"
          data-category="all"
        >
          Všechny zápasy
        </button>
        <button 
          class="cz-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 border border-white/10 transition-all"
          data-category="champions-league"
        >
          🏆 Liga Mistrů
        </button>
        <button 
          class="cz-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 border border-white/10 transition-all"
          data-category="premier-league"
        >
          ⚽ Premier League
        </button>
        <button 
          class="cz-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 text-gray-300 border border-white/10 transition-all"
          data-category="czech-league"
        >
          🇨🇿 Chance Liga & ČR
        </button>
      </div>

      <!-- Matches Grid -->
      <div id="cz-matches-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {serverMatches.map((m) => (
          <div 
            class="cz-match-card rounded-3xl bg-gray-900/90 border border-white/10 hover:border-primary-500/60 p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 shadow-xl backdrop-blur-md group"
            data-category={m.category}
          >
            <div>
              <!-- Header -->
              <div class="flex items-center justify-between text-xs mb-4 pb-3 border-b border-white/10">
                <span class="text-gray-400 font-semibold flex items-center gap-1.5 truncate max-w-[170px]">
                  <Trophy class="w-3.5 h-3.5 text-primary-400 shrink-0" />
                  <span>{m.league}</span>
                </span>

                {m.isLive ? (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[10px] font-black uppercase tracking-wider animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>{m.status}</span>
                  </span>
                ) : (
                  <span class="text-[10px] font-bold text-gray-400 bg-white/5 px-2.5 py-1 rounded-full border border-white/10">
                    {m.status}
                  </span>
                )}
              </div>

              <!-- Score Board -->
              <div class="space-y-4 mb-5">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3 min-w-0">
                    <img 
                      src={m.homeTeam.logo} 
                      alt={m.homeTeam.name} 
                      class="w-7 h-7 object-contain shrink-0" 
                      loading="lazy"
                      onerror="this.src='https://a.espncdn.com/i/teamlogos/soccer/500/default.png'"
                    />
                    <span class="font-bold text-white text-base truncate group-hover:text-primary-300 transition-colors">
                      {m.homeTeam.name}
                    </span>
                  </div>
                  <span class="text-2xl font-black text-emerald-400 ml-3">
                    {m.homeTeam.score}
                  </span>
                </div>

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3 min-w-0">
                    <img 
                      src={m.awayTeam.logo} 
                      alt={m.awayTeam.name} 
                      class="w-7 h-7 object-contain shrink-0" 
                      loading="lazy"
                      onerror="this.src='https://a.espncdn.com/i/teamlogos/soccer/500/default.png'"
                    />
                    <span class="font-bold text-white text-base truncate group-hover:text-primary-300 transition-colors">
                      {m.awayTeam.name}
                    </span>
                  </div>
                  <span class="text-2xl font-black text-emerald-400 ml-3">
                    {m.awayTeam.score}
                  </span>
                </div>
              </div>

              {m.venue && (
                <div class="text-[11px] text-gray-500 mb-4 flex items-center gap-1.5">
                  <Calendar class="w-3 h-3 text-gray-400" />
                  <span>{m.venue}</span>
                </div>
              )}
            </div>

            <!-- Card Bottom Broadcast Action -->
            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-semibold">
                <Zap class="w-3.5 h-3.5" /> 4K Ultra HD
              </span>
              <a 
                href="/#pricing" 
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs font-bold transition-all shadow-md hover:scale-105"
              >
                <span>Sledovat Živě</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Sports Broadcast Banner Promo -->
      <div class="glass p-8 sm:p-12 rounded-3xl mb-16 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-primary-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-500/20 text-primary-300 text-xs font-bold mb-4">
            <Tv class="w-3.5 h-3.5" /> Všechny Prémiové Sporty
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-4">
            Už nikdy nezmeškejte gól ani závod Formule 1
          </h2>
          <p class="text-gray-300 text-sm sm:text-base mb-6 leading-relaxed">
            S předplatným IPTV-CZ získáte kompletní přístup k Nova Sport 1-6, Canal+ Sport, Premier Sport, O2 TV Sport a tisícům mezinárodních sportovních kanálů bez blackoutu a výpadků.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a 
              href="/#pricing" 
              class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white font-bold px-6 py-3 rounded-full text-sm transition-all shadow-lg hover:scale-105"
            >
              <span>Aktivovat předplatné od 5 €</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a 
              href="https://wa.me/18036582620?text=Dobr%C3%BD%20den,%20chci%20vyzkou%C5%A1et%20IPTV%20pro%20sledov%C3%A1n%C3%AD%20sportu" 
              class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-full text-sm transition-all"
            >
              <span>Vyzkoušet přes WhatsApp</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Sports FAQs -->
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-white text-center mb-8">
          Často kladené otázky k živým přenosům
        </h2>
        <div class="space-y-4">
          {liveScoresFaqs.map((faq) => (
            <div class="glass p-6 rounded-2xl">
              <h3 class="text-base sm:text-lg font-bold text-white mb-2 flex items-start gap-2">
                <CheckCircle2 class="w-5 h-5 text-primary-400 shrink-0 mt-0.5" />
                <span>{faq.question}</span>
              </h3>
              <p class="text-gray-400 text-sm leading-relaxed pl-7">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

  <FloatingWhatsApp />
  <ExitPopup />
</Layout>

<script is:inline>
  // Filter tabs logic
  const filterBtns = document.querySelectorAll('.cz-filter-btn');
  const cards = document.querySelectorAll('.cz-match-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-primary-600', 'text-white', 'shadow-lg');
        b.classList.add('bg-white/5', 'text-gray-300');
      });
      btn.classList.add('active', 'bg-primary-600', 'text-white', 'shadow-lg');
      btn.classList.remove('bg-white/5', 'text-gray-300');

      const cat = btn.getAttribute('data-category');
      cards.forEach(card => {
        if (cat === 'all' || card.getAttribute('data-category') === cat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
