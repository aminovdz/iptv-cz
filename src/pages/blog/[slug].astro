---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { Calendar, User, ArrowLeft, Tv } from 'lucide-astro';
import { formatWithCurrentYear } from '../../utils/year';

export const prerender = true;
export async function getStaticPaths() {
  const postEntries = await getCollection('guides');
  return postEntries.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'guides'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const displayTitle = formatWithCurrentYear(post.data.title);
const displayDescription = formatWithCurrentYear(post.data.description);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": displayTitle,
  "description": displayDescription,
  "datePublished": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": post.data.author
  }
};
---

<Layout title={`${displayTitle} | IPTV-CZ`} description={displayDescription} schema={schema}>
  <StickyHeader />
  <main class="pt-32 pb-24">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/blog" class="inline-flex items-center gap-2 text-gray-400 hover:text-white mb-8 transition-colors">
        <ArrowLeft class="w-4 h-4" /> Zpět na návody
      </a>
      
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6 leading-tight">{displayTitle}</h1>
        <div class="flex flex-wrap items-center gap-6 text-gray-400 text-sm">
          <div class="flex items-center gap-2">
            <User class="w-4 h-4" /> {post.data.author}
          </div>
          <div class="flex items-center gap-2">
            <Calendar class="w-4 h-4" />
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('cs-CZ')}
            </time>
          </div>
        </div>
      </header>

      {post.data.image && (
        <div class="mb-12 rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
          <img src={post.data.image} alt={displayTitle} class="w-full object-cover aspect-[21/9]" />
        </div>
      )}

      <div class="glass p-8 md:p-12 rounded-3xl prose prose-invert prose-primary prose-lg max-w-none">
        <Content />
      </div>
      
      <!-- CTA Promo Injected into the Blog Post -->
      <div class="mt-12 bg-gradient-to-r from-primary-900 to-gray-900 border border-primary-500/30 rounded-3xl p-8 md:p-12 text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmZmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSI+PHBhdGggZD0iTTM2IDM0djI2SDI0VjM0aDEyek0yNCAzNFYwaDEydjM0SDI0eiIgLz48L2c+PC9nPjwvc3ZnPg==')]"></div>
        <div class="relative z-10">
          <Tv class="w-12 h-12 text-primary-400 mx-auto mb-4" />
          <h3 class="text-3xl font-bold text-white mb-4">Hledáte spolehlivou IPTV CZ?</h3>
          <p class="text-gray-300 mb-8 max-w-2xl mx-auto">Přestaňte řešit výpadky a zasekávání. IPTV-CZ nabízí 4K kvalitu, obří archív a exkluzivní bonus pro 12měsíční plán.</p>
          <a href="/" class="inline-flex bg-primary-500 hover:bg-primary-600 text-white font-bold py-4 px-8 rounded-xl transition-all shadow-[0_0_30px_rgba(17,69,126,0.3)] hover:scale-105">
            Získat IPTV-CZ za 35 EUR/rok
          </a>
        </div>
      </div>

    </article>
  </main>
  <FloatingWhatsApp />
</Layout>
