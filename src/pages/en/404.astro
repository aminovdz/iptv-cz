---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/en/StickyHeader.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { WifiOff, Home, ArrowLeft } from 'lucide-astro';
---

<Layout title="Page Not Found | IPTV-CZ" description="Sorry, but the requested page was not found.">
  <StickyHeader />
  <main class="min-h-screen pt-32 pb-24 flex items-center justify-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex justify-center items-center w-24 h-24 rounded-full bg-red-500/10 mb-8 ring-4 ring-red-500/20">
        <WifiOff class="w-12 h-12 text-red-500" />
      </div>
      <h1 class="text-6xl md:text-8xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500 mb-6">404</h1>
      <h2 class="text-3xl font-bold text-white mb-6">Oops! Signal lost.</h2>
      <p class="text-xl text-gray-400 mb-10 max-w-xl mx-auto">
        It looks like the page you are looking for does not exist, has been moved, or is temporarily unavailable.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button onclick="window.history.back()" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gray-800 hover:bg-gray-700 text-white rounded-full font-bold transition-colors">
          <ArrowLeft class="w-5 h-5" />
          Go Back
        </button>
        <a href="/en" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-500 hover:bg-primary-600 text-white rounded-full font-bold shadow-lg shadow-primary-500/25 transition-all hover:scale-105">
          <Home class="w-5 h-5" />
          Homepage
        </a>
      </div>
    </div>
  </main>
  <FloatingWhatsApp />
</Layout>
