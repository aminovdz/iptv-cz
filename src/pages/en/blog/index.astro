---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import StickyHeader from '../../../components/en/StickyHeader.astro';
import FloatingWhatsApp from '../../../components/FloatingWhatsApp.astro';
import { ArrowRight, BookOpen } from 'lucide-astro';

const posts = await getCollection('guides');
posts.sort((a: CollectionEntry<'guides'>, b: CollectionEntry<'guides'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Guides and Tips for IPTV | IPTV-CZ" description="Read our expert guides on setting up IPTV, choosing apps, and troubleshooting for Smart TV and Android.">
  <StickyHeader />
  <main class="pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-500/10 text-primary-400 border border-primary-500/20 text-sm font-medium mb-6">
          <BookOpen class="w-4 h-4" /> Knowledge Base
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">IPTV Guides and Tips</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">Everything you need to know to perfectly set up your TV.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <a href={`/en/blog/${post.slug}/`} class="glass rounded-2xl overflow-hidden group hover:-translate-y-2 transition-transform duration-300 flex flex-col">
            {post.data.image && (
              <div class="w-full h-48 overflow-hidden">
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="p-8 flex flex-col h-full">
              <div class="flex gap-2 mb-4">
                {post.data.tags.slice(0,2).map((tag: string) => (
                  <span class="text-xs font-bold bg-white/10 text-gray-300 px-2 py-1 rounded-md">{tag}</span>
                ))}
              </div>
              <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-primary-400 transition-colors">{post.data.title}</h2>
              <p class="text-gray-400 mb-6 flex-grow line-clamp-3">{post.data.description}</p>
              <div class="flex justify-between items-center text-sm font-medium pt-4 border-t border-white/10 mt-auto">
                <span class="text-primary-400 flex items-center gap-1 group-hover:gap-2 transition-all">Read article <ArrowRight class="w-4 h-4" /></span>
                <time class="text-gray-500" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('cs-CZ')}
                </time>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <FloatingWhatsApp />
</Layout>
