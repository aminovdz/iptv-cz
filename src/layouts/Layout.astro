---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FooterEn from '../components/en/Footer.astro';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, any>;
  lang?: string;
}

const { title, description, schema, lang = "cs" } = Astro.props;
const currentUrl = new URL(Astro.url.pathname, Astro.site);

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "IPTV-CZ",
  "url": "https://iptv-cz.net",
  "logo": "https://iptv-cz.net/logo.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "contact@iptv-cz.net",
    "contactType": "customer service"
  }
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="canonical" href={currentUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  </head>
  <body class="bg-gray-950 text-gray-100 font-sans antialiased min-h-screen flex flex-col">
    <slot />
    {lang === 'cs' ? <Footer /> : <FooterEn />}
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @plugin "@tailwindcss/typography";

  @theme {
    /* CZ Flag Colors mapped to Tailwind */
    --color-primary-50: #eff6ff;
    --color-primary-100: #dbeafe;
    --color-primary-500: #11457E; /* CZ Blue */
    --color-primary-600: #0e3765;
    --color-primary-700: #0b2a4c;
    
    --color-secondary-50: #fef2f2;
    --color-secondary-100: #fee2e2;
    --color-secondary-500: #D7141A; /* CZ Red */
    --color-secondary-600: #ac1015;
    --color-secondary-700: #810c10;
  }

  body {
    margin: 0;
  }
  
  /* Glassmorphism utilities */
  .glass {
    @apply bg-white/10 backdrop-blur-md border border-white/20 shadow-xl;
  }
</style>
