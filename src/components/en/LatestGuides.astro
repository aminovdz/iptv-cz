---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ArrowRight, BookOpen } from 'lucide-astro';

const posts = await getCollection('guides');
posts.sort((a: CollectionEntry<'guides'>, b: CollectionEntry<'guides'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 3);
---

<section id="guides" class="py-24 bg-gray-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-500/10 text-primary-400 border border-primary-500/20 text-sm font-medium mb-4">
          <BookOpen class="w-4 h-4" /> Knowledge Library
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">Latest IPTV Guides</h2>
        <p class="text-gray-400 max-w-2xl">Get the most out of your subscription with our tips and tricks.</p>
      </div>
      <a href="/en/blog" class="inline-flex items-center gap-2 text-primary-400 font-bold hover:text-primary-300 transition-colors group whitespace-nowrap">
        View all guides <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {latestPosts.map(post => (
        <a href={`/en/blog/${post.slug}/`} class="glass rounded-2xl overflow-hidden group hover:-translate-y-2 transition-transform duration-300 flex flex-col">
          {post.data.image && (
            <div class="w-full h-48 overflow-hidden relative">
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 to-transparent z-10"></div>
              <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          )}
          <div class="p-8 flex flex-col h-full relative z-20 -mt-12 bg-gradient-to-b from-transparent to-gray-900/50">
            <div class="flex gap-2 mb-4">
              {post.data.tags.slice(0,2).map((tag: string) => (
                <span class="text-xs font-bold bg-white/10 backdrop-blur-md text-white border border-white/20 px-2 py-1 rounded-md">{tag}</span>
              ))}
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary-400 transition-colors">{post.data.title}</h3>
            <p class="text-gray-400 mb-6 flex-grow line-clamp-2 text-sm">{post.data.description}</p>
            <div class="flex justify-between items-center text-sm font-medium pt-4 border-t border-white/10 mt-auto">
              <span class="text-primary-400 flex items-center gap-1 group-hover:gap-2 transition-all">Read more <ArrowRight class="w-4 h-4" /></span>
              <time class="text-gray-500 text-xs" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US')}
              </time>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
