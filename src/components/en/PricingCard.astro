---
import { Check } from 'lucide-astro';

interface Props {
  title: string;
  price: string;
  period: string;
  features: string[];
  isPopular?: boolean;
  bonus?: string;
}

const { title, price, period, features, isPopular = false, bonus } = Astro.props;
---
<div class={`relative rounded-3xl p-8 transition-transform duration-300 hover:-translate-y-1 ${isPopular ? 'bg-gradient-to-b from-primary-900/80 to-gray-900 border-2 border-primary-500 shadow-[0_0_30px_rgba(17,69,126,0.3)] scale-105 z-10' : 'glass'}`}>
  {isPopular && (
    <div class="absolute -top-4 left-0 right-0 flex justify-center">
      <span class="bg-primary-500 text-white text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider">
        Most Popular
      </span>
    </div>
  )}
  
  <h3 class="text-2xl font-bold text-white mb-2">{title}</h3>
  <div class="flex items-baseline gap-2 mb-6">
    <span class="text-5xl font-extrabold text-white">{price}</span>
    <span class="text-gray-400 font-medium">/ {period}</span>
  </div>
  
  {bonus && (
    <div class="bg-secondary-500/20 border border-secondary-500/30 rounded-lg p-3 mb-6 text-sm text-secondary-100 font-medium flex items-center gap-2">
      <span class="text-lg">🎁</span> {bonus}
    </div>
  )}
  
  <a href="https://wa.me/18036582620" class={`w-full block text-center py-3.5 rounded-xl font-bold transition-all mb-8 ${isPopular ? 'bg-primary-500 hover:bg-primary-600 text-white shadow-lg' : 'bg-white/10 hover:bg-white/20 text-white border border-white/10'}`}>
    Order Now
  </a>
  
  <ul class="space-y-4">
    {features.map(feature => (
      <li class="flex items-start gap-3">
        <Check class="w-5 h-5 text-primary-400 shrink-0 mt-0.5" />
        <span class="text-gray-300 text-sm leading-tight">{feature}</span>
      </li>
    ))}
  </ul>
</div>
