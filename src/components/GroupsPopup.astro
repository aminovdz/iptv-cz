---
import { MessageSquare, Send, X } from 'lucide-astro';
---
<div id="groups-popup" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="glass rounded-3xl p-6 max-w-sm w-full mx-4 relative transform scale-95 translate-y-4 transition-all duration-300" id="groups-popup-content">
    <button id="close-groups-popup" class="absolute top-4 right-4 text-gray-400 hover:text-white bg-white/5 rounded-full p-1 transition-colors">
      <X class="w-5 h-5" />
    </button>
    
    <div class="text-center mb-6 pt-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-500/20 text-secondary-300 border border-secondary-500/30 text-xs font-bold uppercase tracking-wider mb-4">
        🎁 VIP Slevy a Novinky
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Přidejte se do naší VIP komunity!</h3>
      <p class="text-gray-400 text-sm">Získejte okamžitý přístup k exkluzivním slevám, novinkám a bleskové podpoře jako první.</p>
    </div>
    
    <div class="space-y-3">
      <a href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" target="_blank" rel="noopener" class="flex items-center gap-3 w-full bg-[#25D366]/10 hover:bg-[#25D366]/20 border border-[#25D366]/30 text-white p-3 rounded-xl transition-colors group">
        <MessageSquare class="w-6 h-6 text-[#25D366] group-hover:scale-110 transition-transform" />
        <div class="text-left">
          <p class="font-bold text-sm">Připojit se na WhatsApp</p>
          <p class="text-xs text-gray-400">Okamžité odpovědi a upozornění</p>
        </div>
      </a>
      
      <a href="https://t.me/castvera_com" target="_blank" rel="noopener" class="flex items-center gap-3 w-full bg-[#229ED9]/10 hover:bg-[#229ED9]/20 border border-[#229ED9]/30 text-white p-3 rounded-xl transition-colors group">
        <Send class="w-6 h-6 text-[#229ED9] group-hover:scale-110 transition-transform" />
        <div class="text-left">
          <p class="font-bold text-sm">Připojit se na Telegram</p>
          <p class="text-xs text-gray-400">Exkluzivní VIP diskuze</p>
        </div>
      </a>
    </div>
  </div>
</div>

<script>
  // Show popup after 3 seconds if not closed before
  setTimeout(() => {
    if(!localStorage.getItem('groups_popup_closed')) {
      const popup = document.getElementById('groups-popup');
      const content = document.getElementById('groups-popup-content');
      if(popup && content) {
        popup.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-95', 'translate-y-4');
      }
    }
  }, 3000);

  document.getElementById('close-groups-popup')?.addEventListener('click', () => {
    const popup = document.getElementById('groups-popup');
    const content = document.getElementById('groups-popup-content');
    if(popup && content) {
      popup.classList.add('opacity-0', 'pointer-events-none');
      content.classList.add('scale-95', 'translate-y-4');
      localStorage.setItem('groups_popup_closed', 'true');
    }
  });
</script>
