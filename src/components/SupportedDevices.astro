---
import { Tv, Monitor, Smartphone, Cast } from 'lucide-astro';

const devices = [
  { icon: Tv, name: "Smart TV", list: "Samsung, LG, Sony, Philips, Android TV" },
  { icon: Smartphone, name: "Mobily & Tablety", list: "iOS (iPhone/iPad), Android zařízení" },
  { icon: Monitor, name: "Počítače", list: "Windows, macOS, Webový prohlížeč" },
  { icon: Cast, name: "Set-top boxy", list: "MAG, Formuler, Apple TV, Firestick, Chromecast" }
];
---
<section id="devices" class="py-24 bg-gray-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-12">
      <div class="w-full md:w-1/2">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Podporujeme všechna vaše oblíbená zařízení</h2>
        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
          Nezáleží na tom, zda jste doma u velké obrazovky nebo na cestách s mobilem. Naše IPTV CZ funguje stabilně napříč všemi platformami. Pro Smart TV doporučujeme aplikace jako IBO Player.
        </p>
        <a href="https://wa.me/18036582620" class="inline-flex items-center gap-2 text-primary-400 font-bold hover:text-primary-300 transition-colors">
          Jak nastavit IPTV na mém zařízení? &rarr;
        </a>
      </div>
      
      <div class="w-full md:w-1/2 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {devices.map(device => (
          <div class="glass p-6 rounded-2xl hover:bg-white/10 transition-colors cursor-default">
            <device.icon class="w-8 h-8 text-primary-400 mb-4" />
            <h3 class="text-white font-bold text-lg mb-2">{device.name}</h3>
            <p class="text-gray-400 text-sm">{device.list}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
